APP_ENV=production
APP_ORIGIN=https://your-domain.example

DB_HOST=127.0.0.1
DB_NAME=civicai_app
DB_USER=replace-with-dedicated-db-user
DB_PASS=replace-with-strong-password

GEMINI_API_KEY=replace-with-server-side-key
GEMINI_MODEL=replace-with-supported-model
# Defaults off. For a restricted project deployment, enable only for 18+ reviewers using synthetic data
# and after checking the configured Gemini tier/terms. Real resident data requires separate LGU/DPO approval.
AI_PROCESSING_APPROVED=false
AI_DAILY_CAP=50
AI_USER_DAILY_CAP=10
